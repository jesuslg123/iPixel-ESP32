{
  "name": "iPixel-ESP32",
  "version": "0.2.0",
  "description": "BLE library for controlling iPixel LED matrix displays from ESP32",
  "keywords": ["ble", "led", "matrix", "iPixel", "NimBLE", "display"],
  "repository": {
    "type": "git",
    "url": "https://github.com/ToBiDi0410/iPixel-ESP32"
  },
  "authors": {
    "name": "ToBiDi0410"
  },
  "license": "MIT",
  "frameworks": "arduino",
  "platforms": "espressif32",
  "dependencies": {
    "h2zero/NimBLE-Arduino": "^2.1.0",
    "erriez/ErriezCRC32": "^1.0.1",
    "adafruit/Adafruit GFX Library": "^1.12.3"
  },
  "build": {
    "srcDir": "src",
    "includeDir": "include",
    "srcFilter": "+<*.cpp> -<main.cpp> -<examples/>"
  }
}
